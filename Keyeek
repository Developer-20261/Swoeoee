--[[\
  JAYZHELBADING - MOBILE & PC OVERLAY SCRIPT
--]]

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "JAYZHELBADING_OVERLAY"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 999999999

if syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = CoreGui
elseif gethui then
    ScreenGui.Parent = gethui()
else
    local success = pcall(function()
        ScreenGui.Parent = CoreGui
    end)
    if not success then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

local BlackScreen = Instance.new("Frame")
BlackScreen.Size = UDim2.new(1, 0, 1, 0)
BlackScreen.Position = UDim2.new(0, 0, 0, 0)
BlackScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
BlackScreen.BorderSizePixel = 0
BlackScreen.Active = true
BlackScreen.Parent = ScreenGui

local BigText = Instance.new("TextLabel")
BigText.Size = UDim2.new(0.9, 0, 0.4, 0)
BigText.Position = UDim2.new(0.05, 0, 0.3, 0)
BigText.BackgroundTransparency = 1
BigText.TextColor3 = Color3.fromRGB(255, 255, 255)
BigText.Text = "BADING ANG GUMAMIT"
BigText.Font = Enum.Font.FredokaOne
BigText.TextScaled = true
BigText.Parent = BlackScreen

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(200, 50)
CloseBtn.Position = UDim2.new(0.5, -100, 0.75, 0)
CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Text = "CLOSE (OR PRESS INSERT)"
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 12
CloseBtn.Parent = BlackScreen

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 8)
BtnCorner.Parent = CloseBtn

local function removeUI()
    ScreenGui:Destroy()
end

CloseBtn.MouseButton1Click:Connect(removeUI)
CloseBtn.TouchTap:Connect(removeUI)

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Insert then
        removeUI()
    end
end)
