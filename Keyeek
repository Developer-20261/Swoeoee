local function C_19()
    local script = JOSHBNS_G2L["19"];
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local CoreGui = game:GetService("CoreGui")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer
    local ScreenGui = script.Parent
    local MainFrame = ScreenGui:FindFirstChild("Main")
    local ResetButton = MainFrame:FindFirstChild("Body"):FindFirstChild("Reset")
    local TitleBar = MainFrame:FindFirstChild("TitleBar")
    local circleButton = CoreGui:FindFirstChild("JOSHBNS_CircleButton"):FindFirstChild("ImageButton")
    local TELEPORT_LOCATION = Vector3.new(546.40, 79.72, -365.68)
    local STEAL_DISTANCE = 25
    local isAutoTeleportOn = false
    local resetCooldown = false
    local isRagdolled = false
    local guiOpen = true
    local Character = nil
    local HRP = nil
    local Humanoid = nil
    local isAutoStealOn = false
    local ragdollCheckConnection = nil
    local bypassConnection = nil
    local isBypassed = false

    local function getCharacter()
        return LocalPlayer.Character
    end

    local function getHumanoid()
        local char = getCharacter()
        if char then
            return char:FindFirstChildOfClass("Humanoid")
        end
        return nil
    end

    local function getHRP()
        local char = getCharacter()
        if char then
            return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
        end
        return nil
    end

    local function performTeleport()
        if resetCooldown then return end
        resetCooldown = true
        local char = getCharacter()
        if not char then
            resetCooldown = false
            return
        end
        local hrp = getHRP()
        if not hrp then
            resetCooldown = false
            return
        end
        local parts = {}
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") and part ~= hrp then
                parts[part] = part.Position - hrp.Position
            end
        end
        hrp.CFrame = CFrame.new(TELEPORT_LOCATION)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
        for part, offset in pairs(parts) do
            if part and part.Parent then
                part.CFrame = CFrame.new(TELEPORT_LOCATION + offset)
                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                part.Velocity = Vector3.new(0, 0, 0)
                part.RotVelocity = Vector3.new(0, 0, 0)
            end
        end
        task.wait(0.1)
        task.delay(0.05, function()
            resetCooldown = false
        end)
    end

    local function bypassAntiCheat()
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local cam = workspace.CurrentCamera
        local camPos = cam.CFrame
        local camSubject = cam.CameraSubject
        local clone = humanoid:Clone()
        clone.Parent = char
        humanoid:Destroy()
        task.wait(0.1)
        local newHum = char:FindFirstChildOfClass("Humanoid")
        if newHum then
            if camSubject and camSubject:IsDescendantOf(workspace) then
                cam.CameraSubject = camSubject
            else
                cam.CameraSubject = newHum
            end
            cam.CFrame = camPos
            Character = char
            Humanoid = newHum
            isBypassed = true
            newHum.PlatformStand = false
            newHum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    local function maintainBypass()
        if not Character or not Humanoid then return end
        if not isBypassed then return end
        local state = Humanoid:GetState()
        if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Physics then
            pcall(function()
                Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end

    local function getPromptPart(prompt)
        local parent = prompt.Parent
        if parent:IsA("BasePart") then return parent end
        if parent:IsA("Attachment") then return parent.Parent end
        if parent:IsA("Model") then
            return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
        end
        return parent:FindFirstChildWhichIsA("BasePart", true)
    end

    local function findNearestSteal()
        if not HRP or not HRP.Parent then return nil end
        local closest = nil
        local closestDistance = STEAL_DISTANCE
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local action = string.lower(tostring(obj.ActionText or ""))
                local stealKeywords = {"steal", "grab", "take", "collect", "rob", "loot", "pickpocket", "snatch"}
                local isStealAction = false
                for _, keyword in ipairs(stealKeywords) do
                    if string.find(action, keyword) then
                        isStealAction = true
                        break
                    end
                end
                local promptName = string.lower(obj.Name or "")
                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                if isStealAction or string.find(promptName, "steal") or string.find(parentName, "steal") then
                    local part = getPromptPart(obj)
                    if part and part:IsA("BasePart") and part.Parent then
                        local distance = (HRP.Position - part.Position).Magnitude
                        if distance <= closestDistance then
                            closestDistance = distance
                            closest = obj
                        end
                    end
                end
            end
        end
        return closest
    end

    local function activatePrompt(prompt)
        if not prompt or not prompt:IsDescendantOf(Workspace) then return false end
        if not prompt.Enabled then return false end
        pcall(function()
            prompt.HoldDuration = 0.01
            prompt:InputHoldBegin()
            task.wait(0.01)
            prompt:InputHoldEnd()
        end)
        pcall(function()
            prompt:Activate()
        end)
        pcall(function()
            fireproximityprompt(prompt, 1, 0.01, false)
        end)
        return true
    end

    local function performAutoSteal()
        if not isAutoStealOn then return end
        if not HRP or not HRP.Parent then return end
        local prompt = findNearestSteal()
        if not prompt then return end
        for i = 1, 10 do
            pcall(function()
                prompt.HoldDuration = 0.01
                prompt:InputHoldBegin()
                task.wait(0.01)
                prompt:InputHoldEnd()
            end)
            pcall(function()
                prompt:Activate()
            end)
            pcall(function()
                fireproximityprompt(prompt, 1, 0.01, false)
            end)
            task.wait()
        end
    end

    local function checkForRagdoll()
        local char = getCharacter()
        if not char then return end
        local humanoid = getHumanoid()
        if not humanoid then return end
        local isRagdolledNow = false
        if humanoid.PlatformStand then isRagdolledNow = true end
        local hrp = getHRP()
        if hrp and not isRagdolledNow then
            local orientation = hrp.Orientation
            if math.abs(orientation.X) > 70 or math.abs(orientation.Z) > 70 then
                isRagdolledNow = true
            end
        end
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
            isRagdolledNow = true
        end
        if isRagdolledNow and isAutoTeleportOn and not isRagdolled then
            isRagdolled = true
            performTeleport()
        elseif not isRagdolledNow then
            isRagdolled = false
        end
    end

    local function setupRagdollDetection()
        if ragdollCheckConnection then
            ragdollCheckConnection:Disconnect()
            ragdollCheckConnection = nil
        end
        local humanoid = getHumanoid()
        if not humanoid then return end
        ragdollCheckConnection = RunService.Heartbeat:Connect(function()
            if not isAutoTeleportOn then return end
            checkForRagdoll()
        end)
        humanoid.StateChanged:Connect(function(oldState, newState)
            if not isAutoTeleportOn then return end
            if newState == Enum.HumanoidStateType.Physics or newState == Enum.HumanoidStateType.PlatformStand or newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.FallingDown then
                isRagdolled = true
                performTeleport()
            elseif newState == Enum.HumanoidStateType.Running or newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Landed then
                isRagdolled = false
            end
        end)
    end

    local function setupCharacter(char)
        if not char then return end
        Character = char
        Humanoid = char:WaitForChild("Humanoid")
        HRP = char:WaitForChild("HumanoidRootPart")
        setupRagdollDetection()
        if isAutoTeleportOn then
            task.wait(0.3)
            bypassAntiCheat()
        end
    end

    local function toggleAutoTeleport()
        isAutoTeleportOn = not isAutoTeleportOn
        isAutoStealOn = isAutoTeleportOn
        if isAutoTeleportOn then
            ResetButton.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
            ResetButton.Text = "AUTO TELEPORT: ON"
            task.spawn(function()
                if LocalPlayer.Character then
                    bypassAntiCheat()
                    if not bypassConnection then
                        bypassConnection = RunService.Heartbeat:Connect(function()
                            if isAutoTeleportOn then
                                maintainBypass()
                            end
                        end)
                    end
                end
            end)
        else
            ResetButton.BackgroundColor3 = Color3.fromRGB(0, 190, 0)
            ResetButton.Text = "AUTO TELEPORT: OFF"
            isRagdolled = false
            isBypassed = false
            if bypassConnection then
                bypassConnection:Disconnect()
                bypassConnection = nil
            end
        end
        local scaleUp = TweenService:Create(ResetButton, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(1, -28, 0, 44)})
        local scaleDown = TweenService:Create(ResetButton, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Size = UDim2.new(1, -32, 0, 40)})
        scaleUp:Play()
        scaleUp.Completed:Connect(function()
            scaleDown:Play()
        end)
    end

    local function setupDrag()
        local dragging = false
        local dragStart = nil
        local startPos = nil
        local function updateDrag(input)
            local delta = input.Position - dragStart
            local newX = math.clamp(startPos.X.Scale + delta.X / MainFrame.Parent.AbsoluteSize.X, 0, 1 - MainFrame.Size.X.Scale)
            local newY = math.clamp(startPos.Y.Scale + delta.Y / MainFrame.Parent.AbsoluteSize.Y, 0, 1 - MainFrame.Size.Y.Scale)
            MainFrame.Position = UDim2.new(newX, 0, newY, 0)
        end
        TitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = MainFrame.Position
            end
        end)
        TitleBar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    updateDrag(input)
                end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local function startStealLoop()
        task.spawn(function()
            while task.wait(0.01) do
                if isAutoStealOn and HRP and HRP.Parent then
                    performAutoSteal()
                end
            end
        end)
    end

    setupDrag()
    ResetButton.MouseButton1Click:Connect(function()
        toggleAutoTeleport()
    end)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.R then
            performTeleport()
        end
    end)
    circleButton.MouseButton1Click:Connect(function()
        local scaleUp = TweenService:Create(circleButton, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(0, 48, 0, 48)})
        local scaleDown = TweenService:Create(circleButton, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Size = UDim2.new(0, 43, 0, 43)})
        scaleUp:Play()
        scaleUp.Completed:Connect(function()
            scaleDown:Play()
        end)
        guiOpen = not guiOpen
        ScreenGui.Enabled = guiOpen
    end)
    circleButton.MouseEnter:Connect(function()
        TweenService:Create(circleButton, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(0, 47, 0, 47)}):Play()
    end)
    circleButton.MouseLeave:Connect(function()
        TweenService:Create(circleButton, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(0, 43, 0, 43)}):Play()
    end)
    if LocalPlayer.Character then
        setupCharacter(LocalPlayer.Character)
    else
        LocalPlayer.CharacterAdded:Connect(setupCharacter)
    end
    startStealLoop()
end

task.spawn(C_19);
return JOSHBNS_G2L["1"], require;

